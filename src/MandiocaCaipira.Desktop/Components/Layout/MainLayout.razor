@inherits LayoutComponentBase
@inject BackupService Backup
@inject NovidadesService Novidades

<div class="shell">
    <NavSidebar OnBackup="CriarBackup" />
    <div class="main-content">
        @Body
    </div>
</div>

@if (_backupMsg is not null)
{
    <ModalOverlay OnClose="() => _backupMsg = null">
        <div class="card-header">Backup</div>
        <div class="card-body">
            <AlertMessage Message="@_backupMsg" IsError="_backupErro" />
            <div class="btn-group" style="justify-content:flex-end">
                <button class="btn btn-secondary" @onclick="() => _backupMsg = null">Fechar</button>
            </div>
        </div>
    </ModalOverlay>
}

@if (_novidades is not null)
{
    <ModalOverlay OnClose="FecharNovidades" Width="460">
        <div class="card-body" style="padding:24px">
            <h2 style="font-size:18px;font-weight:600;margin:0 0 4px">Mandioca Caipira @(_novidades.Value.Versao)</h2>
            <p style="font-size:13px;color:var(--text-muted);margin:0 0 20px">@DateTime.Today.ToString("d 'de' MMMM 'de' yyyy", Fmt.PtBr)</p>

            <p style="font-size:13px;font-weight:600;margin:0 0 10px">Destaques</p>

            @foreach (var (titulo, desc) in _novidades.Value.Itens)
            {
                <p style="margin:0 0 8px;line-height:1.5;font-size:13.5px">
                    <strong>@titulo.</strong> @desc
                </p>
            }

            @if (_primeiraVez)
            {
                <p style="margin:16px 0 0;line-height:1.5;font-size:12.5px;color:var(--text-muted)">
                    Se você tinha o programa em outra pasta, pode apagar ela.
                    Seus dados ficam em @CaminhosDados.DiretorioBase.
                </p>
            }

            <div style="text-align:right;margin-top:20px">
                <button class="btn btn-primary" @onclick="FecharNovidades">Fechar</button>
            </div>
        </div>
    </ModalOverlay>
}

@code {
    private string? _backupMsg;
    private bool _backupErro;
    private (string Versao, (string Titulo, string Descricao)[] Itens)? _novidades;
    private bool _primeiraVez;

    protected override void OnInitialized()
    {
        _novidades = Novidades.Verificar();
        _primeiraVez = Novidades.PrimeiraVez;
    }

    private void FecharNovidades()
    {
        Novidades.MarcarComoVisto();
        _novidades = null;
    }

    private void CriarBackup()
    {
        try
        {
            var path = Backup.Criar();
            _backupMsg = $"Backup criado com sucesso em:\n{path}";
            _backupErro = false;
        }
        catch (Exception ex)
        {
            _backupMsg = $"Não foi possível criar o backup: {ex.Message}";
            _backupErro = true;
        }
    }
}
