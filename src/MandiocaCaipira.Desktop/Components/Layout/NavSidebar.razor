@inject NovidadesService Novidades
@inject IJSRuntime JS

<aside class="sidebar">
    <div class="sidebar-header">Mandioca Caipira</div>
    <nav>
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Início</NavLink>
        <NavLink class="nav-item" href="clientes">Clientes</NavLink>
        <NavLink class="nav-item" href="venda">Nova venda</NavLink>
        <NavLink class="nav-item" href="pagamento">Pagamento</NavLink>
        <NavLink class="nav-item" href="pendencias">Pendências</NavLink>
        <NavLink class="nav-item" href="historico">Histórico</NavLink>

        <div class="sidebar-section">Caixa</div>
        <NavLink class="nav-item" href="fluxo-caixa">Fluxo de caixa</NavLink>
        <NavLink class="nav-item" href="conferencia-saldo">Conferência</NavLink>

        <div class="sidebar-section">Compras</div>
        <NavLink class="nav-item" href="fornecedores">Fornecedores</NavLink>
        <NavLink class="nav-item" href="nova-compra">Nova compra</NavLink>
        <NavLink class="nav-item" href="historico-compras">Compras</NavLink>
    </nav>

    <div class="sidebar-utils">
        <button class="nav-item" @onclick="OnBackup">Fazer backup</button>
        <NavLink class="nav-item" href="restaurar">Restaurar backup</NavLink>
        <NavLink class="nav-item" href="atualizar">Atualizar</NavLink>
        <NavLink class="nav-item" href="reportar-problema">Reportar problema</NavLink>
    </div>

    <div class="sidebar-footer" style="display:flex;align-items:center;justify-content:space-between">
        <span>v@(Novidades.VersaoAtual)</span>
        <button class="theme-toggle" @onclick="AlternarTema"
                title="@(_dark ? "Modo claro" : "Modo escuro")">
            @if (_dark)
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            }
        </button>
    </div>
</aside>

@code {
    [Parameter] public EventCallback OnBackup { get; set; }

    private bool _dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tema = await JS.InvokeAsync<string>("getTheme");
            _dark = tema == "dark";
            StateHasChanged();
        }
    }

    private async Task AlternarTema()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("setTheme", _dark ? "dark" : "light");
    }
}
