@page "/atualizar"
@inject UpdateService Updates

<div class="page-header">
    <h1>Atualização</h1>
    <p>Verifique e instale novas versões do sistema</p>
</div>

<div class="page-body">
    @if (_mensagem is not null)
    {
        <div class="alert @(_erro ? "alert-error" : "alert-success")">@_mensagem</div>
    }

    <div class="card">
        <div class="card-body" style="text-align:center;padding:40px">
            @if (_verificando)
            {
                <p>Verificando atualizações...</p>
            }
            else if (_atualizando)
            {
                <p>Baixando e instalando atualização... O aplicativo será reiniciado.</p>
            }
            else if (Updates.UpdateAvailable)
            {
                <p style="margin-bottom:16px">
                    Nova versão disponível: <strong>@Updates.NewVersion</strong>
                </p>
                <button class="btn btn-primary" @onclick="InstalarAtualizacao">Instalar atualização</button>
            }
            else
            {
                <p style="margin-bottom:16px">Você está usando a versão mais recente.</p>
                <button class="btn btn-secondary" @onclick="Verificar">Verificar novamente</button>
            }
        </div>
    </div>
</div>

@code {
    private bool _verificando;
    private bool _atualizando;
    private string? _mensagem;
    private bool _erro;

    protected override async Task OnInitializedAsync()
    {
        await Verificar();
    }

    private async Task Verificar()
    {
        _mensagem = null;
        _verificando = true;
        StateHasChanged();

        try
        {
            await Updates.CheckForUpdatesAsync();
        }
        catch (Exception ex)
        {
            _mensagem = $"Não foi possível verificar atualizações: {ex.Message}";
            _erro = true;
        }
        finally
        {
            _verificando = false;
        }
    }

    private async Task InstalarAtualizacao()
    {
        _mensagem = null;
        _atualizando = true;
        StateHasChanged();

        try
        {
            await Updates.ApplyUpdateAsync();
        }
        catch (Exception ex)
        {
            _mensagem = $"Falha ao atualizar: {ex.Message}";
            _erro = true;
            _atualizando = false;
        }
    }
}
